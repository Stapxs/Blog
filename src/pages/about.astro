---
import AboutView from "../components/pages/AboutView";
import Root from "../layouts/Root.astro";
import { SITE_TITLE } from "../consts";
---

<Root title={`关于 | ${SITE_TITLE}`} description="啊吧啊吧，这是 SS！">
    <AboutView />
    <script>
    import { play } from "../scripts/scramble";
    import { textMotionOk } from "../scripts/settings";

    const HELLO_API =
        "https://api.stapxs.cn/inner/home/sensor.lin_xiao_huai_de_macbook_pro_frontmost_app";
    const STEAM_API = "https://api.stapxs.cn/steam/status";
    const REFRESH_S = 30;

    let lastRun = 0;
    let lastState = "";
    let appPart: { state: string; time: string } | null = null;
    let steamPart: { online: boolean; game: string | null } | null = null;

    async function loadHello() {
        const el = document.querySelector<HTMLElement>(
            "#about-hello [data-hello-text]",
        );
        if (!el) return;
        if (Date.now() - lastRun < 1000) return;
        lastRun = Date.now();
        loading = true;
        renderCountdown();

        const [ha, steam] = await Promise.allSettled([
            fetch(HELLO_API, { signal: AbortSignal.timeout(10_000) }).then(
                (r) => r.json(),
            ),
            fetch(STEAM_API, { signal: AbortSignal.timeout(10_000) }).then(
                (r) => r.json(),
            ),
        ]);

        if (ha.status === "fulfilled" && ha.value?.state) {
            /* last_updated 是 UTC ISO 串，转本地时间只取时分 */
            const t = new Date(ha.value.last_updated);
            const hh = String(t.getHours()).padStart(2, "0");
            const mm = String(t.getMinutes()).padStart(2, "0");
            appPart = { state: ha.value.state, time: `${hh}:${mm}` };
        }
        if (steam.status === "fulfilled" && steam.value?.data) {
            const d = steam.value.data;
            steamPart = {
                online: d.personastate !== 0,
                game: d.gameextrainfo ?? null,
            };
        }
        loading = false;
        countdown = REFRESH_S;
        renderCountdown();

        if (!appPart && !steamPart) return;

        const plain = `${
            appPart ? `小槐正在使用 ${appPart.state}（${appPart.time}）` : ""
        }${
            steamPart
                ? `${appPart ? "，" : ""}Steam ${
                      steamPart.online ? "在线" : "不在线"
                  }${
                      steamPart.online
                          ? `，${
                                steamPart.game
                                    ? `正在玩 ${steamPart.game}`
                                    : "但是什么都没玩儿"
                            }`
                          : ""
                  }`
                : ""
        }`;
        if (plain === lastState) return;
        lastState = plain;

        const colorSpan = (
            text: string,
            color: string,
            small = false,
        ) => {
            const s = document.createElement("span");
            s.textContent = text;
            s.style.color = color;
            if (small) s.style.fontSize = "0.85em";
            return s;
        };
        const graySpan = (text: string, small = false) =>
            colorSpan(text, "rgb(var(--gray))", small);
        const yellowSpan = (text: string) =>
            colorSpan(text, "var(--yellow)");
        el.replaceChildren();
        if (appPart) {
            el.append("小槐正在使用 ");
            el.append(yellowSpan(appPart.state));
            el.append(" ");
            el.append(graySpan(`（${appPart.time}）`, true));
        }
        if (steamPart) {
            el.append(`${appPart ? "，" : ""}Steam `);
            if (steamPart.online) {
                const s = document.createElement("span");
                s.textContent = "在线";
                s.style.color = "var(--green)";
                el.append(s);
                if (steamPart.game) {
                    el.append("，正在玩 ");
                    el.append(yellowSpan(steamPart.game));
                } else {
                    el.append("，");
                    el.append(graySpan("但是什么都没玩儿"));
                }
            } else {
                el.append(graySpan("不在线"));
            }
        }

        if (textMotionOk()) play(el, { duration: 800 });
    }

    let countdown = REFRESH_S;
    let loading = false;
    let secTimer: number | undefined;

    const renderCountdown = () => {
        const cd = document.getElementById("about-refresh");
        if (cd) cd.textContent = loading ? "--" : `${countdown}s`;
    };

    function stopTimer() {
        if (secTimer === undefined) return;
        window.clearInterval(secTimer);
        secTimer = undefined;
    }

    function startTimer() {
        if (secTimer !== undefined) return;
        renderCountdown();
        secTimer = window.setInterval(() => {
            if (!document.querySelector("#about-hello")) {
                stopTimer();
                return;
            }
            if (loading) return; // 请求在路上：本秒跳过（耗时计入间隔）
            countdown--;
            if (countdown <= 0) {
                void loadHello(); // 到 0 触发，loading 态接管
            } else {
                renderCountdown();
            }
        }, 1000);
    }

    startTimer();
    void loadHello();

    document.addEventListener("astro:after-swap", () => {
        if (!document.querySelector("#about-hello")) {
            stopTimer();
            return;
        }
        lastState = "";
        renderCountdown();
        void loadHello();
        startTimer();
    });
</script>
</Root>
