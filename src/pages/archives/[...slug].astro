---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPostView from '../../components/pages/BlogPostView';
import Comments from '../../components/Comments.astro';
import Root from '../../layouts/Root.astro';
import { formatDateLocal } from '../../scripts/datetime';
import { fetchSongDetail } from '../../scripts/songDetail';

export async function getStaticPaths() {
	const posts = (await getCollection('blog')).filter((p) => !p.data.hidden);
	return posts.map((post) => ({
		params: { slug: post.id },
		props: post,
	}));
}

type Props = CollectionEntry<'blog'>;

const post = Astro.props;
const { Content } = await render(post);

// 字数统计：CJK 按字计数，英文/数字按词计数
const body = post.body ?? '';
const wordCount =
	(body.match(/[\u4e00-\u9fff]/g) ?? []).length +
	(body.match(/[a-zA-Z0-9]+(?:['’-][a-zA-Z0-9]+)*/g) ?? []).length;

// 关联歌曲（frontmatter music 字段）：构建期取详情，失败静默跳过
const song = post.data.music
	? await fetchSongDetail(post.data.music)
	: undefined;
---

<Root title={post.data.title} description={post.data.description} backToTop>
	<BlogPostView
		location="Archives"
		title={post.data.title}
		author={post.data.author}
		pubDate={formatDateLocal(post.data.pubDate)}
		updatedDate={post.data.updatedDate ? formatDateLocal(post.data.updatedDate) : undefined}
		wordCount={wordCount}
		song={song ?? undefined}
	>
		<Content />
	</BlogPostView>
	<Comments />
</Root>
