---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead";
import FloatActions from "../components/FloatActions";
import Footer from "../components/Footer";
import Header from "../components/Header";
import musicStyles from "../components/MusicPlayer.module.css";
import { SITE_TITLE } from "../consts";
import "../styles/global.css";
import "../styles/link-cards.css";
import "../styles/md-alerts.css";
import "../styles/code-blocks.css";

/* 切页幽灵层会把旧页面的元素带进新页面，因此各组页面级样式需要全站常驻 */
import "../components/pages/BlogIndex.module.css";
import "../components/pages/BlogPostView.module.css";
import "../components/pages/CategoryTagsView.module.css";
import "../components/pages/EnvView.module.css";
import "../components/pages/AboutView.module.css";
import "../components/pages/FriendsView.module.css";
import "../components/pages/PhotosView.module.css";
import "@waline/client/waline.css";
import "../styles/waline.css";
import "../styles/comments.css";
import "pixelarticons/fonts/pixelart-icons-font.css";

interface Props {
    title: string;
    description: string;
    /** og:image（文章页传正文第一张图，其余页面不传）*/
    image?: Pick<ImageMetadata, "src">;
    /** 文章页：右下角悬浮区显示「回到顶部」按钮。 */
    backToTop?: boolean;
}

const { title, description, image, backToTop = false } = Astro.props;

/* umami 统计，仅生产构建注入 */
const ENV = import.meta.env as Record<string, string | undefined>;
const umamiSrc = ENV.PUBLIC_UMAMI_SRC ?? "https://status.stapxs.cn/script.js";
const umamiSiteId =
    ENV.PUBLIC_UMAMI_ID ?? "d8f1b578-64ec-4b37-a67e-839c93af9efd";
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-mode="system">
    <head>
        <BaseHead
            title={title}
            description={description}
            image={image?.src}
            site={Astro.site?.href ?? Astro.url.origin}
            pathname={Astro.url.pathname}
            pageUrl={Astro.url.href}
            generator={Astro.generator}
        />
        {/* umami 统计：data-domains */}
        {import.meta.env.PROD && (
            <script
                is:inline
                defer
                src={umamiSrc}
                data-website-id={umamiSiteId}
                data-domains="blog.stapxs.cn"
            />
        )}
        <script is:inline>
            (function () {
                // 首次加载标记 boot 序列
                if (
                    !window.__bootPlayed &&
                    !window.matchMedia("(prefers-reduced-motion: reduce)")
                        .matches
                ) {
                    window.__bootPlayed = true;
                    document.documentElement.classList.add("boot");
                }

                (function () {
                    /* 主题偏好三态：system（跟随系统，默认）/ light / dark；
                     * data-theme-mode = 偏好，data-theme = 实际生效主题
                     * （现有 CSS 与 Waline 均监听后者） */
                    var mq = window.matchMedia("(prefers-color-scheme: dark)");
                    var readPref = function () {
                        var v = null;
                        try {
                            v = localStorage.getItem("theme");
                        } catch (e) {}
                        return v === "light" || v === "dark" ? v : "system";
                    };
                    var resolve = function (pref) {
                        return pref === "system"
                            ? mq.matches
                                ? "dark"
                                : "light"
                            : pref;
                    };
                    var LABELS = {
                        dark: "切换主题，当前暗色",
                        light: "切换主题，当前亮色",
                        system: "切换主题，当前跟随系统",
                    };
                    var syncButton = function (pref) {
                        var btn = document.getElementById("theme-toggle");
                        if (btn) {
                            btn.setAttribute("aria-label", LABELS[pref]);
                            btn.setAttribute("title", LABELS[pref]);
                        }
                    };
                    var apply = function () {
                        var pref = readPref();
                        var root = document.documentElement;
                        root.dataset.themeMode = pref;
                        root.dataset.theme = resolve(pref);
                        syncButton(pref);
                    };
                    apply();
                    document.addEventListener("astro:after-swap", apply);
                    /* 首屏时按钮尚未解析，page-load 后再同步一次无障碍标签 */
                    document.addEventListener("astro:page-load", function () {
                        syncButton(
                            document.documentElement.dataset.themeMode ||
                                "system",
                        );
                    });

                    /* 偏好为「跟随系统」时，系统深浅色切换实时生效 */
                    var onSchemeChange = function () {
                        var root = document.documentElement;
                        if ((root.dataset.themeMode || "system") === "system")
                            root.dataset.theme = resolve("system");
                    };
                    if (mq.addEventListener)
                        mq.addEventListener("change", onSchemeChange);
                    else if (mq.addListener) mq.addListener(onSchemeChange);

                    document.addEventListener("click", function (e) {
                        var btn = e.target.closest("#theme-toggle");
                        if (!btn) return;
                        var root = document.documentElement;
                        /* 循环：暗色 → 亮色 → 跟随系统 → 暗色 */
                        var CYCLE = {
                            dark: "light",
                            light: "system",
                            system: "dark",
                        };
                        var next = CYCLE[root.dataset.themeMode] || "dark";
                        /* umami：主题切换（这里拿到的 next 即切换后的模式；
                         * is:inline 无法 import helper，直接调全局） */
                        if (window.umami)
                            window.umami.track("theme_switch", { to: next });
                        var applyTheme = function () {
                            root.dataset.themeMode = next;
                            root.dataset.theme = resolve(next);
                            try {
                                localStorage.setItem("theme", next);
                            } catch (e) {}
                            syncButton(next);
                        };

                        var reduceMotion = window.matchMedia(
                            "(prefers-reduced-motion: reduce)",
                        ).matches;
                        if (!document.startViewTransition || reduceMotion) {
                            applyTheme();
                            return;
                        }

                        var x = e.clientX;
                        var y = e.clientY;
                        var endRadius = Math.hypot(
                            Math.max(x, window.innerWidth - x),
                            Math.max(y, window.innerHeight - y),
                        );

                        // 像素圆（光栅化）：按圆方程逐列/行求边界格数
                        // floor(√(n²-k²))，轮廓全是横平竖直的台阶。
                        // 按四个象限弧走（顶→右→底→左），连接处为单格台阶、无斜边
                        var PIXEL_GRID = 150;
                        var pixelCirclePoints = function (cx, cy, r, grid) {
                            var n = Math.ceil(r / grid);
                            var t = function (k) {
                                return Math.floor(
                                    Math.sqrt(Math.max(0, n * n - k * k)),
                                );
                            };
                            var pts = [];
                            var push = function (gx, gy) {
                                pts.push([
                                    (cx + gx * grid).toFixed(1),
                                    (cy + gy * grid).toFixed(1),
                                ]);
                            };
                            // 右上：顶点 (0,-n) → 右点 (n+1,0)
                            for (var gx = 0; gx <= n; gx++) {
                                push(gx, -t(gx));
                                push(gx + 1, -t(gx));
                            }
                            // 右下：右点 (n,0) → 底点 (0,n+1)
                            for (var gy = 0; gy <= n; gy++) {
                                push(t(gy), gy);
                                push(t(gy), gy + 1);
                            }
                            // 左下：底点 (0,n) → 左点 (-n-1,0)
                            for (var lx = 0; lx >= -n; lx--) {
                                push(lx, t(lx));
                                push(lx - 1, t(lx));
                            }
                            // 左上：左点 (-n,0) → 顶点 (0,-n-1)
                            for (var ly = 0; ly >= -n; ly--) {
                                push(-t(ly), ly);
                                push(-t(ly), ly - 1);
                            }
                            return pts;
                        };
                        var toPolygon = function (pts) {
                            return (
                                "polygon(" +
                                pts
                                    .map(function (p) {
                                        return p[0] + "px " + p[1] + "px";
                                    })
                                    .join(",") +
                                ")"
                            );
                        };
                        var endPts = pixelCirclePoints(
                            x,
                            y,
                            endRadius + PIXEL_GRID,
                            PIXEL_GRID,
                        );
                        // 起点：同顶点数全部收缩在圆心 → 插值过程即像素圆等比放大
                        var startPts = endPts.map(function () {
                            return [x.toFixed(1), y.toFixed(1)];
                        });

                        root.classList.add("theme-rippling");
                        var transition =
                            document.startViewTransition(applyTheme);

                        transition.ready
                            .then(function () {
                                document.documentElement.animate(
                                    {
                                        clipPath: [
                                            toPolygon(startPts),
                                            toPolygon(endPts),
                                        ],
                                    },
                                    {
                                        duration: 600,
                                        easing: "ease-in",
                                        pseudoElement:
                                            "::view-transition-new(root)",
                                    },
                                );
                            })
                            .catch(function () {});

                        transition.finished
                            .finally(function () {
                                root.classList.remove("theme-rippling");
                            })
                            .catch(function () {});
                    });
                })();
            })();

            (function () {
                // 打字机 placeholder：每次面板打开时逐字打出「输入关键词…」
                var PLACEHOLDER = "输入关键词…";
                var typingTimer = null;
                var typePlaceholder = function (input) {
                    window.clearTimeout(typingTimer);
                    var i = 0;
                    input.setAttribute("placeholder", "");
                    var tick = function () {
                        if (i <= PLACEHOLDER.length) {
                            input.setAttribute(
                                "placeholder",
                                PLACEHOLDER.slice(0, i),
                            );
                            i++;
                            typingTimer = window.setTimeout(tick, 90);
                        }
                    };
                    typingTimer = window.setTimeout(tick, 250);
                };

                document.addEventListener("click", function (e) {
                    var panel = document.getElementById("search-panel");
                    if (!panel) return;
                    var btn = e.target.closest("#search-toggle");
                    if (btn) {
                        var opened = panel.classList.toggle("open");
                        if (opened) {
                            var input = panel.querySelector("input");
                            if (input) {
                                input.focus();
                                if (!input.value) typePlaceholder(input);
                            }
                        }
                        return;
                    }
                    if (!e.target.closest("#search-panel")) {
                        panel.classList.remove("open");
                        window.clearTimeout(typingTimer);
                        var inp = panel.querySelector("input");
                        inp?.setAttribute("placeholder", PLACEHOLDER);
                    }
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape") {
                        var panel = document.getElementById("search-panel");
                        panel?.classList.remove("open");
                    }
                });
                document.addEventListener("astro:after-swap", function () {
                    document
                        .getElementById("search-panel")
                        ?.classList.remove("open");
                });

                // 输入即预热索引 + 回车通过 ClientRouter 跳转搜索页
                document.addEventListener("input", function (e) {
                    var input = e.target.closest
                        ? e.target.closest("#search-panel input")
                        : null;
                    if (input && !window.__searchIndex) {
                        window.__searchIndex = fetch("/search-index.json").then(
                            function (r) {
                                return r.json();
                            },
                        );
                    }
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key !== "Enter") return;
                    var input = e.target.closest
                        ? e.target.closest("#search-panel input")
                        : null;
                    if (!input) return;
                    var q = input.value.trim();
                    if (!q) return;
                    /* umami：搜索面板提交 */
                    if (window.umami)
                        window.umami.track("search", {
                            source: "panel",
                            keyword: q.slice(0, 100),
                        });
                    var a = document.createElement("a");
                    a.href = "/search?q=" + encodeURIComponent(q);
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    document
                        .getElementById("search-panel")
                        ?.classList.remove("open");
                });

                // ".." = 返回上一页（history.back，等价浏览器后退）
                document.addEventListener("click", function (e) {
                    var back = e.target.closest("#history-back");
                    if (!back) return;
                    e.preventDefault();
                    if (history.length > 1) history.back();
                    else location.href = "/";
                });

                // "#back-to-top" = 回到顶部（平滑滚动，减弱动效时直接跳）
                document.addEventListener("click", function (e) {
                    var top = e.target.closest("#back-to-top");
                    if (!top) return;
                    var reduce = window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches;
                    window.scrollTo({
                        top: 0,
                        behavior: reduce ? "auto" : "smooth",
                    });
                });

                // "#music-toggle" = 音乐面板开关
                var musicOpen = false;
                var syncMusicPanel = function () {
                    document.documentElement.classList.toggle(
                        "music-open",
                        musicOpen,
                    );
                    var musicBtn = document.getElementById("music-toggle");
                    if (musicBtn)
                        musicBtn.setAttribute(
                            "aria-expanded",
                            String(musicOpen),
                        );
                };
                document.addEventListener("click", function (e) {
                    var btn = e.target.closest("#music-toggle");
                    if (btn) {
                        musicOpen = !musicOpen;
                        syncMusicPanel();
                        if (musicOpen)
                            window.dispatchEvent(new Event("music-panel-open"));
                        return;
                    }
                    if (
                        musicOpen &&
                        !e.target.closest("#music-panel, [data-song-id]")
                    ) {
                        musicOpen = false;
                        syncMusicPanel();
                    }
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && musicOpen) {
                        musicOpen = false;
                        syncMusicPanel();
                    }
                });
                window.addEventListener(
                    "music-panel-open-request",
                    function () {
                        if (musicOpen) return;
                        musicOpen = true;
                        syncMusicPanel();
                        window.dispatchEvent(new Event("music-panel-open"));
                    },
                );
                document.addEventListener("astro:after-swap", syncMusicPanel);

                // 点击像素涟漪
                (function () {
                    if (
                        window.matchMedia("(prefers-reduced-motion: reduce)")
                            .matches
                    )
                        return;
                    /* 半径 r 的 1 格厚像素圆环 */
                    var ring = function (r) {
                        var cells = new Set();
                        var add = function (x, y) {
                            cells.add(x + "," + y);
                        };
                        for (var x = -r; x <= r; x++) {
                            var y = Math.round(Math.sqrt(r * r - x * x));
                            add(x, y);
                            add(x, -y);
                        }
                        for (var k = -r; k <= r; k++) {
                            var j = Math.round(Math.sqrt(r * r - k * k));
                            add(j, k);
                            add(-j, k);
                        }
                        var shadows = [];
                        cells.forEach(function (key) {
                            var p = key.split(",");
                            shadows.push(
                                p[0] * 4 +
                                    "px " +
                                    p[1] * 4 +
                                    "px 0 0 currentColor",
                            );
                        });
                        return shadows.join(",");
                    };
                    document.addEventListener("pointerdown", function (e) {
                        var el = document.createElement("div");
                        el.className = "pixel-ripple";
                        var pz =
                            parseFloat(
                                getComputedStyle(document.documentElement).zoom,
                            ) || 1;
                        el.style.left = (e.clientX - 2) / pz + "px";
                        el.style.top = (e.clientY - 2) / pz + "px";
                        document.documentElement.appendChild(el);
                        var anim = el.animate(
                            [
                                { boxShadow: ring(1), opacity: 1 },
                                { boxShadow: ring(3), opacity: 1, offset: 0.3 },
                                {
                                    boxShadow: ring(5),
                                    opacity: 0.85,
                                    offset: 0.6,
                                },
                                {
                                    boxShadow: ring(7),
                                    opacity: 0.5,
                                    offset: 0.85,
                                },
                                { boxShadow: ring(9), opacity: 0 },
                            ],
                            { duration: 480, easing: "ease-out" },
                        );
                        anim.onfinish = function () {
                            el.remove();
                        };
                        anim.oncancel = function () {
                            el.remove();
                        };
                    });
                })();
            })();
        </script>
        <Font cssVariable="--font-pixel" preload />
        {/* 无刷新导航 */}
        <ClientRouter fallback="swap" />
    </head>
    <body>
        <Header siteTitle={SITE_TITLE} currentPath={Astro.url.pathname} />
        {/* 搜索面板*/}
        <div
            class="search-panel"
            id="search-panel"
            role="dialog"
            aria-label="搜索"
        >
            <span class="search-title">搜索</span>
            <div class="search-row">
                <span class="cmd-prompt">&gt;</span>
                <input
                    class="search-input"
                    type="text"
                    placeholder="输入关键词…"
                    autocomplete="off"
                />
            </div>
        </div>
        <div
            class={musicStyles.panel}
            id="music-panel"
            transition:persist="music-panel"
            role="complementary"
            aria-label="音乐播放器"
        >
            <span class={musicStyles.title}>音乐播放器</span>
            {/* 播放器本体 */}
            <div class={musicStyles.player} id="music-player">
                <span
                    class={`${musicStyles.sp} ${musicStyles.spFuschia}`}
                    id="music-sp1"
                />
                <span
                    class={`${musicStyles.sp} ${musicStyles.spOrange}`}
                    id="music-sp2"
                />
                <span
                    class={`${musicStyles.sp} ${musicStyles.spYellow}`}
                    id="music-sp3"
                />
                <span
                    class={`${musicStyles.sp} ${musicStyles.spGreen}`}
                    id="music-sp4"
                >
                    __________________________________
                </span>
                <span class={musicStyles.ticker} id="music-ticker" />
                <div class={musicStyles.row}>
                    <button
                        type="button"
                        class={musicStyles.btn}
                        id="music-prev"
                        data-colour="grey"
                    />
                    <button
                        type="button"
                        class={musicStyles.btn}
                        id="music-b30"
                        data-colour="grey"
                    />
                    <button
                        type="button"
                        class={musicStyles.btn}
                        id="music-stop"
                        data-colour="grey"
                    />
                    <button
                        type="button"
                        class={musicStyles.btn}
                        id="music-f30"
                        data-colour="grey"
                    />
                    <button
                        type="button"
                        class={musicStyles.btn}
                        id="music-next"
                        data-colour="grey"
                    />
                </div>
                <div class={musicStyles.row}>
                    <span class={musicStyles.time} id="music-time">
                        --:--:--
                    </span>
                    <div class={musicStyles.volgroup}>
                        <button
                            type="button"
                            class={musicStyles.btn}
                            id="music-vminus"
                            data-colour="grey"
                        />
                        <span class={musicStyles.vol} id="music-vol">
                            ....
                        </span>
                        <button
                            type="button"
                            class={musicStyles.btn}
                            id="music-vplus"
                            data-colour="grey"
                        />
                    </div>
                </div>
            </div>
            <div
                class={musicStyles.playlist}
                id="music-playlist"
                data-hover-list
            >
                <p class={musicStyles.empty}>加载中 …</p>
            </div>
        </div>
        <slot />
        <FloatActions backToTop={backToTop} />
        <Footer />
    </body>

    <script>
        import { blankNode, play } from "../scripts/scramble";
        import { track } from "../scripts/analytics";
        import { initMusicPlayer } from "../scripts/musicPlayer";
        import { initPhotoLightbox } from "../scripts/photoLightbox";
        import { initPhotosWall } from "../scripts/photosWall";
        import { initCodeBlocks } from "../scripts/codeBlocks";

        const html = document.documentElement;
        const MOTION_OK = () =>
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        /* ================= 首次加载 boot 序列 ================= */
        if (html.classList.contains("boot")) {
            const show = (el: Element | null) => el?.classList.add("boot-in");
            const one = (s: string) => document.querySelector(s);
            const all = (s: string) => Array.from(document.querySelectorAll(s));

            /* P1（t=0）：标题 chip + 导航链接 —— 打字机 */
            const title = one('[data-boot="title"]');
            if (title) play(title as HTMLElement, { duration: 900 });
            show(title);

            const nav = one('[data-boot="nav"]');
            all('[data-boot="nav"] a').forEach((a, i) => {
                play(a as HTMLElement, { duration: 600, delay: 300 + i * 250 });
            });
            show(nav);

            /* P2（t≈1.5s）：main 框架（内容仍隐藏）+ 右上角图标 + 导航图标 */
            window.setTimeout(() => {
                show(one('[data-boot="main"]'));
                show(one('[data-boot="icons"]'));
                all('[data-boot="nav-icons"]').forEach(show);
                show(one('[data-boot="dock"]'));
            }, 1500);

            /* P3（t≈2.3s）：位置标题 + 命令行 —— 打字机 */
            window.setTimeout(() => {
                const pageTitle = one('[data-boot="pagetitle"]');
                if (pageTitle)
                    play(pageTitle as HTMLElement, { duration: 800 });
                show(pageTitle);

                const cmd = one('[data-boot="cmd"]');
                if (cmd)
                    play(cmd as HTMLElement, { duration: 700, delay: 300 });
                show(cmd);
            }, 2300);

            /* P4（t≈3.4s）：列表 / 正文 —— 打字机 */
            window.setTimeout(() => {
                all('[data-boot="rest"]').forEach((el, i) => {
                    play(el as HTMLElement, { duration: 1300, delay: i * 200 });
                    show(el);
                });
            }, 3400);

            /* 收尾：解除 boot 态；若中途发生页面切换则立即解除 */
            window.setTimeout(() => html.classList.remove("boot"), 5300);
        }

        /* ================= 页面切换编排 ================= */
        const SWAP_KEYS = ["pagetitle", "cmd", "rest"] as const;
        const OVERLAY_KEYS = new Set(["pagetitle", "cmd"]);
        let prevMainHeight: number | null = null;

        document.addEventListener("astro:before-swap", (event) => {
            if (!MOTION_OK()) return;
            const newDoc = (event as Event & { newDocument: Document })
                .newDocument;

            // 记录旧页面 main 高度，交换后做平滑形变
            const oldMain = document.querySelector(
                '[data-boot="main"]',
            ) as HTMLElement | null;
            prevMainHeight = oldMain ? oldMain.offsetHeight : null;

            SWAP_KEYS.forEach((key) => {
                const olds = Array.from(
                    document.querySelectorAll(`[data-boot="${key}"]`),
                );
                const news = Array.from(
                    newDoc.querySelectorAll(`[data-boot="${key}"]`),
                );
                news.forEach((nel, i) => {
                    const oel = olds[i] as HTMLElement | undefined;
                    const target = nel as HTMLElement;

                    target.style.visibility = "hidden";
                    blankNode(target);

                    if (!oel) return; // 无旧元素可克隆，跳过幽灵层创建

                    const host = newDoc.createElement("div");
                    host.dataset.swapHost = key;
                    host.style.position = "relative";
                    host.style.display = "flow-root";
                    const ghost = oel.cloneNode(true) as HTMLElement;
                    ghost.removeAttribute("data-boot");
                    ghost.removeAttribute("id");
                    ghost.dataset.ghost = key;
                    ghost.style.position = "absolute";
                    ghost.style.top = "0";
                    ghost.style.left = "0";
                    ghost.style.width = "100%";
                    ghost.style.boxSizing = "border-box"; // padding 计入 100%，不向右溢出
                    ghost.style.pointerEvents = "none";
                    ghost.style.visibility = "visible";
                    ghost.style.opacity = "1";

                    target.replaceWith(host);
                    host.append(target, ghost);
                });
            });
        });

        document.addEventListener("astro:after-swap", () => {
            // boot 若在进行中，立即解除
            html.classList.remove("boot");

            if (!MOTION_OK()) return;

            // ========== 高度形变 ==========
            let heightMorph: (() => void) | null = null;
            const mainEl = document.querySelector(
                '[data-boot="main"]',
            ) as HTMLElement | null;
            if (mainEl && prevMainHeight !== null) {
                const from = prevMainHeight;
                const to = mainEl.offsetHeight;
                mainEl.style.height = `${from}px`;
                if (Math.abs(to - from) > 2) {
                    heightMorph = () => {
                        mainEl.style.overflow = "hidden";
                        mainEl.getBoundingClientRect(); // 强制回流，让起始高度生效
                        mainEl.style.transition = "height 0.45s ease";
                        mainEl.style.height = `${to}px`;
                        let settled = false;
                        const settle = () => {
                            if (settled) return;
                            settled = true;
                            mainEl.style.height = "";
                            mainEl.style.transition = "";
                            mainEl.style.overflow = "";
                        };
                        mainEl.addEventListener(
                            "transitionend",
                            (ev) => {
                                if (
                                    ev.target === mainEl &&
                                    ev.propertyName === "height"
                                )
                                    settle();
                            },
                            { once: true },
                        );
                        window.setTimeout(settle, 700);
                    };
                } else {
                    heightMorph = () => {
                        mainEl.style.height = "";
                    };
                }
            }
            prevMainHeight = null;

            const hosts = Array.from(
                document.querySelectorAll("[data-swap-host]"),
            );
            if (hosts.length === 0) return;

            // ========== 入场 ==========
            const reveal = (real: HTMLElement) => {
                real.style.visibility = "visible";
                real.animate([{ opacity: "0" }, { opacity: "1" }], {
                    duration: 450,
                    easing: "ease-out",
                });
                play(real, {
                    duration: 900,
                    onDone: () => {
                        real.style.visibility = "";
                    },
                });
            };

            // ========== 分页指示器（data-boot="static"）==========
            const PAG_FADE = 250;
            const fadePagers = (direction: "out" | "in") => {
                document
                    .querySelectorAll<HTMLElement>('main [data-boot="static"]')
                    .forEach((el) => {
                        if (direction === "out") {
                            el.style.visibility = "hidden";
                        } else {
                            el.style.visibility = "visible";
                            el.animate([{ opacity: "0" }, { opacity: "1" }], {
                                duration: PAG_FADE,
                                easing: "ease",
                            });
                        }
                    });
            };

            const restPairs: Array<{ host: HTMLElement; real: HTMLElement }> =
                [];

            // ========== 退场 ==========
            const EXIT_FADE = 200;
            const exitGhost = (ghost: HTMLElement) => {
                ghost.style.transition = `background ${EXIT_FADE}ms ease-in`;
                ghost.getBoundingClientRect();
                ghost.style.background = "transparent";
                // 图片同步淡出
                ghost.querySelectorAll("img").forEach((im) => {
                    (im as HTMLElement).animate(
                        [{ opacity: "1" }, { opacity: "0" }],
                        {
                            duration: EXIT_FADE,
                            easing: "ease-in",
                            fill: "forwards",
                        },
                    );
                });
                // 文字反向解密，完成后幽灵层自行移除
                window.setTimeout(() => {
                    play(ghost, {
                        duration: 700,
                        reverse: true,
                        onDone: () => ghost.remove(),
                    });
                }, EXIT_FADE);
            };

            hosts.forEach((hostEl) => {
                const host = hostEl as HTMLElement;
                const key = host.dataset.swapHost as string;
                const ghost = host.querySelector(
                    "[data-ghost]",
                ) as HTMLElement | null;
                const real = host.querySelector(
                    "[data-boot]",
                ) as HTMLElement | null;
                if (!ghost || !real) return;

                if (OVERLAY_KEYS.has(key)) {
                    // 覆盖更新：新的在底下解密，旧的从上面溶出（replay 模式）
                    reveal(real);
                    play(ghost, {
                        duration: 600,
                        reverse: true,
                        onDone: () => {
                            ghost.remove();
                            host.replaceWith(real);
                        },
                    });
                } else {
                    restPairs.push({ host, real });
                    exitGhost(ghost);
                    fadePagers("out");
                }
            });

            // ========== 退场完成 → 入场 ==========
            let restRevealed = false;
            const revealRest = (force = false) => {
                if (restRevealed) return;
                restRevealed = true;
                restPairs.forEach(({ host, real }) => {
                    const ghost = host.querySelector("[data-ghost]");
                    if (ghost) {
                        if (force) {
                            (ghost as HTMLElement).animate(
                                [{ opacity: "1" }, { opacity: "0" }],
                                { duration: 150, fill: "forwards" },
                            );
                            window.setTimeout(() => ghost.remove(), 160);
                        } else {
                            ghost.remove(); // 正常路径：退场已播完（全空白）
                        }
                    }
                    reveal(real);
                    host.replaceWith(real);
                });
                document
                    .querySelectorAll<HTMLElement>(
                        'main [data-boot="rest"][style*="visibility"]',
                    )
                    .forEach((el) => {
                        if (el.style.visibility === "hidden") reveal(el);
                    });
                // 新内容入场 → 分页指示器同步淡入
                fadePagers("in");
                // 新内容出现的同时开始容器高度过渡
                heightMorph?.();
                heightMorph = null;
            };
            if (restPairs.length > 0) {
                // 轮询等全部幽灵层自行移除（退场动画播完）后入场
                const poll = window.setInterval(() => {
                    if (
                        restPairs.every(
                            ({ host }) => !host.querySelector("[data-ghost]"),
                        )
                    ) {
                        window.clearInterval(poll);
                        revealRest();
                    }
                }, 60);
            } else {
                revealRest();
            }

            // ========== 3s 总兜底 ==========
            window.setTimeout(() => {
                document.querySelectorAll("[data-swap-host]").forEach((h) => {
                    h.querySelector("[data-ghost]")?.remove();
                    const r = h.querySelector("[data-boot]");
                    if (r) {
                        (r as HTMLElement).style.visibility = "";
                        h.replaceWith(r);
                    }
                });
                heightMorph?.();
                heightMorph = null;
            }, 3000);
        });

        /* ================= 列表 hover ================= */
        /* 根缩放（手机端 0.8）：gBCR/指针坐标是缩放后的视觉值，
         * 写回 style 的 px 是未缩放值 —— 两者转换用 */
        const rootZoom = () =>
            parseFloat(getComputedStyle(document.documentElement).zoom) || 1;

        const moveHoverBar = function (list: HTMLElement, row: HTMLElement) {
            const bar = list.querySelector<HTMLElement>("[data-hover-bar]");
            if (!bar) return;
            const z = rootZoom();
            const listRect = list.getBoundingClientRect();
            const rowRect = row.getBoundingClientRect();
            bar.style.height = `${rowRect.height / z}px`;
            bar.style.transform = `translateY(${(rowRect.top - listRect.top) / z + list.scrollTop}px)`;
            bar.style.opacity = "1";
        };

        const hideHoverBar = function (list: HTMLElement) {
            const bar = list.querySelector<HTMLElement>("[data-hover-bar]");
            if (!bar) return;
            bar.style.opacity = "0";
        };

        document.addEventListener("mouseover", (e) => {
            const row = (e.target as HTMLElement).closest<HTMLElement>(
                "a[data-boot-list-row], [data-hover-list] a, [data-hover-list] button",
            );
            const list = row?.closest<HTMLElement>("[data-hover-list]");
            if (row && list) {
                moveHoverBar(list, row);
            } else {
                document
                    .querySelectorAll<HTMLElement>("[data-hover-list]")
                    .forEach(hideHoverBar);
            }
        });

        document.addEventListener(
            "mouseleave",
            () => {
                document
                    .querySelectorAll<HTMLElement>("[data-hover-list]")
                    .forEach(hideHoverBar);
            },
            true,
        );

        /* ================= 回到顶部进度指示器 ================= */
        let progressMain =
            document.querySelector<HTMLElement>('[data-boot="main"]');
        let progressPath = document.querySelector<SVGPathElement>(
            "[data-backtop-path]",
        );
        let progressBtn = document.querySelector<HTMLElement>("#back-to-top");

        const updateTopProgress = () => {
            if (!progressMain || !progressPath) return;
            const vh = window.innerHeight;
            const rect = progressMain.getBoundingClientRect();
            const start = rect.top + window.scrollY; // main 顶贴视口顶时的 scrollY
            const height = progressMain.style.height
                ? progressMain.scrollHeight * rootZoom() // 未缩放值 ×z 转视觉值
                : rect.height;
            const end = start + height - vh; // main 底贴视口底时的 scrollY
            const span = end - start;
            const ratio =
                span > 0
                    ? Math.min(1, Math.max(0, (window.scrollY - start) / span))
                    : 0;
            progressPath.style.strokeDashoffset = String(
                100 - Math.round(ratio * 100),
            );
            progressBtn?.toggleAttribute("data-show", ratio > 0);
        };
        window.addEventListener("scroll", updateTopProgress, {
            passive: true,
        });
        window.addEventListener("resize", updateTopProgress);
        const progressResize = new ResizeObserver(updateTopProgress);
        if (progressMain) progressResize.observe(progressMain);
        document.addEventListener("astro:after-swap", () => {
            progressMain =
                document.querySelector<HTMLElement>('[data-boot="main"]');
            progressPath = document.querySelector<SVGPathElement>(
                "[data-backtop-path]",
            );
            progressBtn = document.querySelector<HTMLElement>("#back-to-top");
            progressResize.disconnect();
            if (progressMain) progressResize.observe(progressMain);
            updateTopProgress();
        });
        updateTopProgress();

        /* 音乐播放器 */
        initMusicPlayer();
        /* 照片灯箱 */
        initPhotoLightbox();
        /* 相簿瀑布流 */
        initPhotosWall();
        /* 代码块复制按钮 */
        initCodeBlocks();
        document.addEventListener("astro:after-swap", initCodeBlocks);

        /* ================= umami 埋点 ================= */
        /* 外链点击 */
        document.addEventListener("click", (e) => {
            const el = e.target as HTMLElement | null;
            const a = el?.closest?.("a[href]");
            if (!a) return;
            const href = a.getAttribute("href") ?? "";
            if (!/^https?:\/\//i.test(href)) return;
            let url: URL;
            try {
                url = new URL(href, location.href);
            } catch {
                return;
            }
            if (url.hostname === location.hostname) return;
            track("outbound", { host: url.hostname, url: href.slice(0, 300) });
        });

        /* 翻页：列表页与搜索页的分页器都是 nav[data-boot="static"] */
        const pageFromHref = (href: string): number | null => {
            try {
                const u = new URL(href, location.href);
                const q = u.searchParams.get("p") ?? u.searchParams.get("page");
                if (q && /^\d+$/.test(q)) return Number(q);
                if (u.pathname === "/") return 1; // 列表页第 1 页即根路径
                const m = u.pathname.match(/\/(\d+)\/?$/);
                if (m) return Number(m[1]);
            } catch {
                /* 非法 href 不上报 */
            }
            return null;
        };
        document.addEventListener("click", (e) => {
            const el = e.target as HTMLElement | null;
            const a = el?.closest?.("a");
            if (!a || !a.closest('nav[data-boot="static"]')) return;
            const page = pageFromHref(a.getAttribute("href") ?? "");
            if (page !== null) track("pagination", { page });
        });
    </script>
</html>
