---
import { Font } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import type { ImageMetadata } from "astro";
import BaseHead from "../components/BaseHead";
import FloatActions from "../components/FloatActions";
import Footer from "../components/Footer";
import Header from "../components/Header";
import musicStyles from "../components/MusicPlayer.module.css";
import FallbackImage from "../assets/blog-placeholder-1.png";
import { SITE_TITLE } from "../consts";
import "../styles/global.css";
/* 切页幽灵层会把旧页面的元素带进新页面，因此各组页面级样式需要全站常驻 */
import "../components/pages/BlogIndex.module.css";
import "../components/pages/BlogPostView.module.css";
import "../components/pages/CategoryTagsView.module.css";
import "../components/pages/EnvView.module.css";

interface Props {
    title: string;
    description: string;
    image?: ImageMetadata;
    /** 文章页：右下角悬浮区显示「回到顶部」按钮。 */
    backToTop?: boolean;
}

const { title, description, image = FallbackImage, backToTop = false } =
    Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dark">
    <head>
        <BaseHead
            title={title}
            description={description}
            image={image.src}
            site={Astro.site?.href ?? Astro.url.origin}
            pathname={Astro.url.pathname}
            pageUrl={Astro.url.href}
            generator={Astro.generator}
        />
        <script is:inline>
            (function () {
                // 首次加载标记 boot 序列
                if (
                    !window.__bootPlayed &&
                    !window.matchMedia("(prefers-reduced-motion: reduce)")
                        .matches
                ) {
                    window.__bootPlayed = true;
                    document.documentElement.classList.add("boot");
                }

                (function () {
                    var apply = function () {
                        document.documentElement.dataset.theme =
                            localStorage.getItem("theme") || "dark";
                    };
                    apply();
                    document.addEventListener("astro:after-swap", apply);

                    document.addEventListener("click", function (e) {
                        var btn = e.target.closest("#theme-toggle");
                        if (!btn) return;
                        var root = document.documentElement;
                        var next =
                            root.dataset.theme === "light" ? "dark" : "light";
                        var applyTheme = function () {
                            root.dataset.theme = next;
                            localStorage.setItem("theme", next);
                        };

                        var reduceMotion = window.matchMedia(
                            "(prefers-reduced-motion: reduce)",
                        ).matches;
                        if (!document.startViewTransition || reduceMotion) {
                            applyTheme();
                            return;
                        }

                        var x = e.clientX;
                        var y = e.clientY;
                        var endRadius = Math.hypot(
                            Math.max(x, window.innerWidth - x),
                            Math.max(y, window.innerHeight - y),
                        );

                        // 像素圆（光栅化）：按圆方程逐列/行求边界格数
                        // floor(√(n²-k²))，轮廓全是横平竖直的台阶。
                        // 按四个象限弧走（顶→右→底→左），连接处为单格台阶、无斜边
                        var PIXEL_GRID = 150;
                        var pixelCirclePoints = function (cx, cy, r, grid) {
                            var n = Math.ceil(r / grid);
                            var t = function (k) {
                                return Math.floor(
                                    Math.sqrt(Math.max(0, n * n - k * k)),
                                );
                            };
                            var pts = [];
                            var push = function (gx, gy) {
                                pts.push([
                                    (cx + gx * grid).toFixed(1),
                                    (cy + gy * grid).toFixed(1),
                                ]);
                            };
                            // 右上：顶点 (0,-n) → 右点 (n+1,0)
                            for (var gx = 0; gx <= n; gx++) {
                                push(gx, -t(gx));
                                push(gx + 1, -t(gx));
                            }
                            // 右下：右点 (n,0) → 底点 (0,n+1)
                            for (var gy = 0; gy <= n; gy++) {
                                push(t(gy), gy);
                                push(t(gy), gy + 1);
                            }
                            // 左下：底点 (0,n) → 左点 (-n-1,0)
                            for (var lx = 0; lx >= -n; lx--) {
                                push(lx, t(lx));
                                push(lx - 1, t(lx));
                            }
                            // 左上：左点 (-n,0) → 顶点 (0,-n-1)
                            for (var ly = 0; ly >= -n; ly--) {
                                push(-t(ly), ly);
                                push(-t(ly), ly - 1);
                            }
                            return pts;
                        };
                        var toPolygon = function (pts) {
                            return (
                                "polygon(" +
                                pts
                                    .map(function (p) {
                                        return p[0] + "px " + p[1] + "px";
                                    })
                                    .join(",") +
                                ")"
                            );
                        };
                        var endPts = pixelCirclePoints(
                            x,
                            y,
                            endRadius + PIXEL_GRID,
                            PIXEL_GRID,
                        );
                        // 起点：同顶点数全部收缩在圆心 → 插值过程即像素圆等比放大
                        var startPts = endPts.map(function () {
                            return [x.toFixed(1), y.toFixed(1)];
                        });

                        root.classList.add("theme-rippling");
                        var transition =
                            document.startViewTransition(applyTheme);

                        transition.ready
                            .then(function () {
                                document.documentElement.animate(
                                    {
                                        clipPath: [
                                            toPolygon(startPts),
                                            toPolygon(endPts),
                                        ],
                                    },
                                    {
                                        duration: 600,
                                        easing: "ease-in",
                                        pseudoElement:
                                            "::view-transition-new(root)",
                                    },
                                );
                            })
                            .catch(function () {});

                        transition.finished
                            .finally(function () {
                                root.classList.remove("theme-rippling");
                            })
                            .catch(function () {});
                    });
                })();
            })();

            (function () {
                // 打字机 placeholder：每次面板打开时逐字打出「输入关键词…」
                var PLACEHOLDER = "输入关键词…";
                var typingTimer = null;
                var typePlaceholder = function (input) {
                    window.clearTimeout(typingTimer);
                    var i = 0;
                    input.setAttribute("placeholder", "");
                    var tick = function () {
                        if (i <= PLACEHOLDER.length) {
                            input.setAttribute("placeholder", PLACEHOLDER.slice(0, i));
                            i++;
                            typingTimer = window.setTimeout(tick, 90);
                        }
                    };
                    typingTimer = window.setTimeout(tick, 250);
                };

                document.addEventListener("click", function (e) {
                    var panel = document.getElementById("search-panel");
                    if (!panel) return;
                    var btn = e.target.closest("#search-toggle");
                    if (btn) {
                        var opened = panel.classList.toggle("open");
                        if (opened) {
                            var input = panel.querySelector("input");
                            if (input) {
                                input.focus();
                                if (!input.value) typePlaceholder(input);
                            }
                        }
                        return;
                    }
                    if (!e.target.closest("#search-panel")) {
                        panel.classList.remove("open");
                        window.clearTimeout(typingTimer);
                        var inp = panel.querySelector("input");
                        inp?.setAttribute("placeholder", PLACEHOLDER);
                    }
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape") {
                        var panel = document.getElementById("search-panel");
                        panel?.classList.remove("open");
                    }
                });
                document.addEventListener("astro:after-swap", function () {
                    document
                        .getElementById("search-panel")
                        ?.classList.remove("open");
                });

                // 输入即预热索引 + 回车通过 ClientRouter 跳转搜索页
                document.addEventListener("input", function (e) {
                    var input = e.target.closest
                        ? e.target.closest("#search-panel input")
                        : null;
                    if (input && !window.__searchIndex) {
                        window.__searchIndex = fetch("/search-index.json").then(
                            function (r) {
                                return r.json();
                            },
                        );
                    }
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key !== "Enter") return;
                    var input = e.target.closest
                        ? e.target.closest("#search-panel input")
                        : null;
                    if (!input) return;
                    var q = input.value.trim();
                    if (!q) return;
                    var a = document.createElement("a");
                    a.href = "/search?q=" + encodeURIComponent(q);
                    document.body.appendChild(a);
                    a.click();
                    a.remove();
                    document
                        .getElementById("search-panel")
                        ?.classList.remove("open");
                });

                // ".." = 返回上一页（history.back，等价浏览器后退）
                document.addEventListener("click", function (e) {
                    var back = e.target.closest("#history-back");
                    if (!back) return;
                    e.preventDefault();
                    if (history.length > 1) history.back();
                    else location.href = "/";
                });

                // "#back-to-top" = 回到顶部（平滑滚动，减弱动效时直接跳）
                document.addEventListener("click", function (e) {
                    var top = e.target.closest("#back-to-top");
                    if (!top) return;
                    var reduce = window.matchMedia(
                        "(prefers-reduced-motion: reduce)",
                    ).matches;
                    window.scrollTo({
                        top: 0,
                        behavior: reduce ? "auto" : "smooth",
                    });
                });

                // "#music-toggle" = 音乐面板开关。状态存 JS 变量而非 html 的 class：
                // 切页时 ClientRouter 会整体替换 <html> 的属性，astro:after-swap 后重挂。
                // 面板本体带 transition:persist，切页前后是同一个 DOM（样式随 class 生效）
                var musicOpen = false;
                var syncMusicPanel = function () {
                    var panel = document.getElementById("music-panel");
                    // 先写顶端坐标再挂 class：打开的第一帧即对齐 main 顶端，
                    // 不触发 top 过渡（top 也不在过渡属性列表里）
                    if (panel && musicOpen) {
                        var main = document.querySelector("main");
                        if (main) {
                            var top = main.getBoundingClientRect().top;
                            panel.style.setProperty(
                                "--music-panel-top",
                                Math.max(top, 8) + "px",
                            );
                        }
                    }
                    document.documentElement.classList.toggle(
                        "music-open",
                        musicOpen,
                    );
                    var musicBtn = document.getElementById("music-toggle");
                    if (musicBtn)
                        musicBtn.setAttribute(
                            "aria-expanded",
                            String(musicOpen),
                        );
                };
                document.addEventListener("click", function (e) {
                    var btn = e.target.closest("#music-toggle");
                    if (!btn) return;
                    musicOpen = !musicOpen;
                    syncMusicPanel();
                });
                document.addEventListener("keydown", function (e) {
                    if (e.key === "Escape" && musicOpen) {
                        musicOpen = false;
                        syncMusicPanel();
                    }
                });
                window.addEventListener("resize", function () {
                    // 视口变化重新对齐 main 顶端（header 高度 / 滚动位置都可能变）
                    if (musicOpen) syncMusicPanel();
                });
                document.addEventListener("astro:after-swap", syncMusicPanel);
            })();
        </script>
        <Font cssVariable="--font-pixel" preload />
        {/* 无刷新导航；页面切换动画由下方幽灵层编排接管，关闭 ClientRouter 自带过渡 */}
        <ClientRouter fallback="swap" />
    </head>
    <body>
        <Header siteTitle={SITE_TITLE} currentPath={Astro.url.pathname} />
        {/* 搜索面板：无遮罩、宽度为正文一半、标题压上边框居中 */}
        <div
            class="search-panel"
            id="search-panel"
            role="dialog"
            aria-label="搜索"
        >
            <span class="search-title">搜索</span>
            <div class="search-row">
                <span class="cmd-prompt">&gt;</span>
                <input
                    class="search-input"
                    type="text"
                    placeholder="输入关键词…"
                    autocomplete="off"
                />
            </div>
        </div>
        {/* 音乐播放器面板：打开时 main 左移腾位、本面板从右缘滑入悬浮占满剩余宽度
            （顶端对齐 main 顶端、底端避让右下角悬浮按钮区；开关逻辑见 head 内联脚本）。
            transition:persist：切页时整棵子树原样保留 —— 面板状态与未来的音频播放不随导航中断 */}
        <div
            class={musicStyles.panel}
            id="music-panel"
            transition:persist="music-panel"
            role="complementary"
            aria-label="音乐播放器"
        >
            <span class={musicStyles.title}>音乐</span>
            <div class={musicStyles.body}>
                <div class={musicStyles.eq} aria-hidden="true">
                    <span></span>
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <p class={musicStyles.hint}>播放器施工中 …</p>
            </div>
        </div>
        <slot />
        {/* 页面右下角悬浮操作区：main 之后的 body 直接子级
            （横向贴页面右缘；纵向 sticky，落位与 main 底边缘对齐） */}
        <FloatActions backToTop={backToTop} />
        <Footer />
    </body>

    {/* 首次加载 boot 序列 + 页面切换编排（模块脚本只执行一次） */}
    <script>
        import { blankNode, play } from "../scripts/scramble";

        const html = document.documentElement;
        const MOTION_OK = () =>
            !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

        /* ================= 首次加载 boot 序列 ================= */
        if (html.classList.contains("boot")) {
            const show = (el: Element | null) => el?.classList.add("boot-in");
            const one = (s: string) => document.querySelector(s);
            const all = (s: string) => Array.from(document.querySelectorAll(s));

            /* P1（t=0）：标题 chip + 导航链接 —— 打字机 */
            const title = one('[data-boot="title"]');
            if (title) play(title as HTMLElement, { duration: 900 });
            show(title);

            const nav = one('[data-boot="nav"]');
            all('[data-boot="nav"] a').forEach((a, i) => {
                play(a as HTMLElement, { duration: 600, delay: 300 + i * 250 });
            });
            show(nav);

            /* P2（t≈1.5s）：main 框架（内容仍隐藏）+ 右上角图标 + 右下角悬浮按钮 —— 淡入 */
            window.setTimeout(() => {
                show(one('[data-boot="main"]'));
                show(one('[data-boot="icons"]'));
                show(one('[data-boot="dock"]'));
            }, 1500);

            /* P3（t≈2.3s）：位置标题 + 命令行 —— 打字机 */
            window.setTimeout(() => {
                const pageTitle = one('[data-boot="pagetitle"]');
                if (pageTitle)
                    play(pageTitle as HTMLElement, { duration: 800 });
                show(pageTitle);

                const cmd = one('[data-boot="cmd"]');
                if (cmd)
                    play(cmd as HTMLElement, { duration: 700, delay: 300 });
                show(cmd);
            }, 2300);

            /* P4（t≈3.4s）：列表 / 正文 —— 打字机（整块，波带自上而下扫过） */
            window.setTimeout(() => {
                all('[data-boot="rest"]').forEach((el, i) => {
                    play(el as HTMLElement, { duration: 1300, delay: i * 200 });
                    show(el);
                });
            }, 3400);

            /* 收尾：解除 boot 态；若中途发生页面切换则立即解除 */
            window.setTimeout(() => html.classList.remove("boot"), 5300);
        }

        /* ================= 页面切换编排 =================
         * 顶栏 / main 框架在所有页面渲染一致 → 硬交换视觉上不动。
         * pagetitle / cmd：旧内容克隆为幽灵层悬浮在新位置上，
         *   交换后同时「旧溶出 + 新解密」（覆盖更新，demo 的 replay 模式）。
         * rest：先等旧内容溶出完成，再解密入场（退场再入场）。 */
        const SWAP_KEYS = ["pagetitle", "cmd", "rest"] as const;
        const OVERLAY_KEYS = new Set(["pagetitle", "cmd"]);
        let prevMainHeight: number | null = null;

        document.addEventListener("astro:before-swap", (event) => {
            if (!MOTION_OK()) return;
            const newDoc = (event as Event & { newDocument: Document })
                .newDocument;

            // 记录旧页面 main 高度，交换后做平滑形变
            const oldMain = document.querySelector(
                '[data-boot="main"]',
            ) as HTMLElement | null;
            prevMainHeight = oldMain ? oldMain.offsetHeight : null;

            SWAP_KEYS.forEach((key) => {
                const olds = Array.from(
                    document.querySelectorAll(`[data-boot="${key}"]`),
                );
                const news = Array.from(
                    newDoc.querySelectorAll(`[data-boot="${key}"]`),
                );
                news.forEach((nel, i) => {
                    const oel = olds[i] as HTMLElement | undefined;
                    const target = nel as HTMLElement;

                    // 新内容入场时机未到：先藏住（无论有无旧元素配对 ——
                    // 未配对的元素没有幽灵层覆盖，不藏会直接裸露闪现）
                    target.style.visibility = "hidden";
                    // 防御性预空白：把文字铺成空白模板（原文存 WeakMap，
                    // play() 会先恢复再解密）—— 之后任何渲染时序下
                    // 都不可能闪现完整内容；非文字内容（背景/图片）
                    // 由 reveal 的 opacity 淡入兜底
                    blankNode(target);

                    if (!oel) return; // 无旧元素可克隆，跳过幽灵层创建

                    // 幽灵宿主：包住 [real, ghost]，ghost absolute 覆盖在 real 未来位置上
                    // flow-root 阻断父子 margin 折叠 → real 的 margin 留在宿主内，
                    // ghost 保留自身 margin 作为 absolute 偏移 → 两者几何对齐
                    const host = newDoc.createElement("div");
                    host.dataset.swapHost = key;
                    host.style.position = "relative";
                    host.style.display = "flow-root";
                    const ghost = oel.cloneNode(true) as HTMLElement;
                    ghost.removeAttribute("data-boot");
                    ghost.removeAttribute("id");
                    ghost.dataset.ghost = key;
                    ghost.style.position = "absolute";
                    ghost.style.top = "0";
                    ghost.style.left = "0";
                    ghost.style.width = "100%";
                    ghost.style.boxSizing = "border-box"; // padding 计入 100%，不向右溢出
                    ghost.style.pointerEvents = "none";
                    ghost.style.visibility = "visible";
                    ghost.style.opacity = "1";

                    target.replaceWith(host);
                    host.append(target, ghost);
                });
            });
        });

        document.addEventListener("astro:after-swap", () => {
            // boot 若在进行中，立即解除（切页优先）
            html.classList.remove("boot");

            if (!MOTION_OK()) return;

            // ========== 高度形变：钉住旧高度，入场动画结束后再过渡 ==========
            // 全程钉在旧高度（退场期间旧幽灵层正好装下，无需裁剪）；
            // 入场动画（900ms 解密）完成后开始过渡到新高度（0.45s）。
            // 注意：目标高度必须在钉住之前测量，否则 offsetHeight 读到内联旧高度。
            let heightMorph: (() => void) | null = null;
            const mainEl = document.querySelector(
                '[data-boot="main"]',
            ) as HTMLElement | null;
            if (mainEl && prevMainHeight !== null) {
                const from = prevMainHeight;
                const to = mainEl.offsetHeight; // 钉住前测量自然高度
                mainEl.style.height = `${from}px`;
                if (Math.abs(to - from) > 2) {
                    heightMorph = () => {
                        mainEl.style.overflow = "hidden";
                        mainEl.getBoundingClientRect(); // 强制回流，让起始高度生效
                        mainEl.style.transition = "height 0.45s ease";
                        mainEl.style.height = `${to}px`;
                        let settled = false;
                        const settle = () => {
                            if (settled) return;
                            settled = true;
                            mainEl.style.height = "";
                            mainEl.style.transition = "";
                            mainEl.style.overflow = "";
                        };
                        mainEl.addEventListener(
                            "transitionend",
                            (ev) => {
                                if (
                                    ev.target === mainEl &&
                                    ev.propertyName === "height"
                                )
                                    settle();
                            },
                            { once: true },
                        );
                        window.setTimeout(settle, 700);
                    };
                } else {
                    // 高度几乎不变：入场时直接解除钉住
                    heightMorph = () => {
                        mainEl.style.height = "";
                    };
                }
            }
            prevMainHeight = null;

            const hosts = Array.from(
                document.querySelectorAll("[data-swap-host]"),
            );
            if (hosts.length === 0) return;

            // ========== 入场 ==========
            // scramble 只操作文字节点；背景色/图片等非文字内容
            // 用整体 opacity 淡入（否则幽灵层消失后会裸露闪现）
            const reveal = (real: HTMLElement) => {
                real.style.visibility = "visible";
                real.animate(
                    [{ opacity: "0" }, { opacity: "1" }],
                    { duration: 450, easing: "ease-out" },
                );
                play(real, {
                    duration: 900,
                    onDone: () => {
                        real.style.visibility = "";
                    },
                });
            };

            // ========== 分页指示器（data-boot="static"）==========
            // 旧内容退场开始时【直接隐藏】；新内容入场时【淡入】
            const PAG_FADE = 250;
            const fadePagers = (direction: "out" | "in") => {
                document
                    .querySelectorAll<HTMLElement>('main [data-boot="static"]')
                    .forEach((el) => {
                        if (direction === "out") {
                            el.style.visibility = "hidden";
                        } else {
                            el.style.visibility = "visible";
                            el.animate(
                                [{ opacity: "0" }, { opacity: "1" }],
                                { duration: PAG_FADE, easing: "ease" },
                            );
                        }
                    });
            };

            const restPairs: Array<{ host: HTMLElement; real: HTMLElement }> =
                [];

            // ========== 退场 ==========
            // 两段式：背景色/图片淡出（scramble 管不到它们）→ 文字反向解密
            const EXIT_FADE = 200;
            const exitGhost = (ghost: HTMLElement) => {
                // 背景色淡出（transition 需强制回流才能产生过渡）
                ghost.style.transition = `background ${EXIT_FADE}ms ease-in`;
                ghost.getBoundingClientRect();
                ghost.style.background = "transparent";
                // 图片同步淡出
                ghost.querySelectorAll("img").forEach((im) => {
                    (im as HTMLElement).animate(
                        [{ opacity: "1" }, { opacity: "0" }],
                        {
                            duration: EXIT_FADE,
                            easing: "ease-in",
                            fill: "forwards",
                        },
                    );
                });
                // 文字反向解密，完成后幽灵层自行移除
                window.setTimeout(() => {
                    play(ghost, {
                        duration: 700,
                        reverse: true,
                        onDone: () => ghost.remove(),
                    });
                }, EXIT_FADE);
            };

            hosts.forEach((hostEl) => {
                const host = hostEl as HTMLElement;
                const key = host.dataset.swapHost as string;
                const ghost = host.querySelector(
                    "[data-ghost]",
                ) as HTMLElement | null;
                const real = host.querySelector(
                    "[data-boot]",
                ) as HTMLElement | null;
                if (!ghost || !real) return;

                if (OVERLAY_KEYS.has(key)) {
                    // 覆盖更新：新的在底下解密，旧的从上面溶出（replay 模式）
                    reveal(real);
                    play(ghost, {
                        duration: 600,
                        reverse: true,
                        onDone: () => {
                            ghost.remove();
                            host.replaceWith(real);
                        },
                    });
                } else {
                    restPairs.push({ host, real });
                    exitGhost(ghost);
                    // 旧内容退场开始 → 指示器直接隐藏（不参与退场）
                    fadePagers("out");
                }
            });

            // ========== 退场完成 → 入场（所有页面统一「先退场后入场」） ==========
            let restRevealed = false;
            const revealRest = (force = false) => {
                if (restRevealed) return;
                restRevealed = true;
                restPairs.forEach(({ host, real }) => {
                    const ghost = host.querySelector("[data-ghost]");
                    if (ghost) {
                        if (force) {
                            // 超时强制：不清 DOM —— 快速淡出收尾，
                            // 避免还在展示中的旧内容被瞬间拔掉导致闪现
                            (ghost as HTMLElement).animate(
                                [{ opacity: "1" }, { opacity: "0" }],
                                { duration: 150, fill: "forwards" },
                            );
                            window.setTimeout(() => ghost.remove(), 160);
                        } else {
                            ghost.remove(); // 正常路径：退场已播完（全空白）
                        }
                    }
                    reveal(real);
                    host.replaceWith(real);
                });
                // 未配对的 rest 元素（旧页面没有对应项，如文章→列表的 pagination）：
                // 没有幽灵层编排，但已被隐藏 —— 此刻统一入场
                document
                    .querySelectorAll<HTMLElement>(
                        'main [data-boot="rest"][style*="visibility"]',
                    )
                    .forEach((el) => {
                        if (el.style.visibility === "hidden") reveal(el);
                    });
                // 新内容入场 → 分页指示器同步淡入
                fadePagers("in");
                // 新内容出现的同时开始容器高度过渡（与入场动画同步）
                heightMorph?.();
                heightMorph = null;
            };
            if (restPairs.length > 0) {
                // 轮询等全部幽灵层自行移除（退场动画播完）后入场
                // —— 试验：去掉 1.5s 超时强制，完全信任退场 onDone 的自移除
                const poll = window.setInterval(() => {
                    if (
                        restPairs.every(
                            ({ host }) => !host.querySelector("[data-ghost]"),
                        )
                    ) {
                        window.clearInterval(poll);
                        revealRest();
                    }
                }, 60);
            } else {
                revealRest();
            }

            // ========== 3s 总兜底：清理所有残留 ==========
            window.setTimeout(() => {
                document.querySelectorAll("[data-swap-host]").forEach((h) => {
                    h.querySelector("[data-ghost]")?.remove();
                    const r = h.querySelector("[data-boot]");
                    if (r) {
                        (r as HTMLElement).style.visibility = "";
                        h.replaceWith(r);
                    }
                });
                heightMorph?.();
                heightMorph = null;
            }, 3000);
        });

        /* ================= 列表 hover 跟随指示条 =================
         * 高亮条挂在列表容器里，mouseover 时测量目标行位置，
         * 用 transform 过渡滑过去 —— 跨行连续动画。 */
        const moveHoverBar = function (list: HTMLElement, row: HTMLElement) {
            const bar = list.querySelector<HTMLElement>("[data-hover-bar]");
            if (!bar) return;
            const listRect = list.getBoundingClientRect();
            const rowRect = row.getBoundingClientRect();
            bar.style.height = `${rowRect.height}px`;
            bar.style.transform = `translateY(${rowRect.top - listRect.top}px)`;
            bar.style.opacity = "1";
        };

        const hideHoverBar = function (list: HTMLElement) {
            const bar = list.querySelector<HTMLElement>("[data-hover-bar]");
            if (!bar) return;
            bar.style.opacity = "0";
        };

        document.addEventListener("mouseover", (e) => {
            const row = (e.target as HTMLElement).closest<HTMLElement>(
                "a[data-boot-list-row], [data-hover-list] a",
            );
            const list = row?.closest<HTMLElement>("[data-hover-list]");
            if (row && list) {
                moveHoverBar(list, row);
            } else {
                document
                    .querySelectorAll<HTMLElement>("[data-hover-list]")
                    .forEach(hideHoverBar);
            }
        });

        document.addEventListener(
            "mouseleave",
            () => {
                document
                    .querySelectorAll<HTMLElement>("[data-hover-list]")
                    .forEach(hideHoverBar);
            },
            true,
        );

        /* ================= 回到顶部进度指示器 =================
         * main 滚动进度：0% = main 顶部到达视口顶部，
         * 100% = main 底部到达视口底部 —— 只按 main 计算，
         * main 之后的 footer（以及将来的评论区）不参与。
         * 描边顺时针行进：path 自左上角顺时针一圈，
         * pathLength=100 → dashoffset=100-进度 即已绘长度。
         * 按钮本身随 data-show 淡入淡出：滚入 main 出现，滚回 main 顶之上消失。 */
        let progressMain = document.querySelector<HTMLElement>(
            '[data-boot="main"]',
        );
        // 按钮内还有图标 svg，必须按 data 标记命中进度环的 path
        let progressPath = document.querySelector<SVGPathElement>(
            "[data-backtop-path]",
        );
        let progressBtn = document.querySelector<HTMLElement>("#back-to-top");

        const updateTopProgress = () => {
            if (!progressMain || !progressPath) return;
            const vh = window.innerHeight;
            const rect = progressMain.getBoundingClientRect();
            const start = rect.top + window.scrollY; // main 顶贴视口顶时的 scrollY
            const end = start + rect.height - vh; // main 底贴视口底时的 scrollY
            const span = end - start;
            const ratio =
                span > 0
                    ? Math.min(1, Math.max(0, (window.scrollY - start) / span))
                    : window.scrollY >= end
                      ? 1
                      : 0;
            progressPath.style.strokeDashoffset = String(
                100 - Math.round(ratio * 100),
            );
            // 滚入 main（进度 > 0）才出现，回到 main 顶部之上淡出
            progressBtn?.toggleAttribute("data-show", ratio > 0);
        };

        window.addEventListener("scroll", updateTopProgress, {
            passive: true,
        });
        window.addEventListener("resize", updateTopProgress);
        document.addEventListener("astro:after-swap", () => {
            // 切页后 DOM 全新：重新抓取元素并立即刷新一次
            progressMain = document.querySelector<HTMLElement>(
                '[data-boot="main"]',
            );
            progressPath = document.querySelector<SVGPathElement>(
                "[data-backtop-path]",
            );
            progressBtn = document.querySelector<HTMLElement>("#back-to-top");
            updateTopProgress();
        });
        updateTopProgress();
    </script>
</html>
