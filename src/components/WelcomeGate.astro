<!--
  首访欢迎
-->

<div
    class="gate"
    id="welcome-gate"
    role="dialog"
    aria-modal="true"
    aria-label="首次访问设置"
>
    <div class="wrap">
        <div class="gateCmd" data-gate-scramble>
            <span class="cmd-prompt">&gt;&nbsp;</span>
            <span class="cmd-name">blog-init&nbsp;</span>
            <span class="cmd-flag">--first-run</span>
        </div>
        <div class="cards">
            <section
                class="card cardCookie"
                data-gate-card="cookie"
                aria-labelledby="gate-cookie-title"
            >
                <h2 class="cardTitle" id="gate-cookie-title">
                    Cookie 使用授权
                </h2>
                <div class="body" data-gate-scramble>
                    <p class="lead">
                        站点的正常运行需要在你的浏览器里存储一点点数据：
                    </p>
                    <ul class="uses">
                        <li class="use">
                            <span class="tag tagNecessary">必要</span>
                            <p>
                                偏好记忆：主题等设置，保存在你浏览器的
                                localStorage 中，不上传任何服务器，始终启用。
                            </p>
                        </li>
                        <li class="use">
                            <span class="tag tagStats">统计</span>
                            <p>
                                访问统计：umami
                                统计脚本，用于了解页面访问情况；匿名、不跨站追踪，仅在授权后运行。
                            </p>
                        </li>
                    </ul>
                    <div class="actions">
                        <button
                            type="button"
                            class="btn btnPrimary"
                            data-gate-accept
                        >
                            全部允许
                        </button>
                        <button type="button" class="btn" data-gate-essential>
                            仅保留必要
                        </button>
                    </div>
                    <!-- 确认回执：替代按钮组显示（文本由脚本写入） -->
                    <p class="doneNote" data-gate-done-note></p>
                    <p class="note">
                        你可以随时通过页脚的齿轮图标重新打开这个窗口。
                    </p>
                </div>
            </section>
            <section
                class="card cardSettings"
                data-gate-card="settings"
                aria-labelledby="gate-settings-title"
            >
                <h2 class="cardTitle" id="gate-settings-title">
                    基本设置
                </h2>
                <div class="body" data-gate-scramble>
                    <div class="setting">
                        <div class="settingText">
                            <span class="settingName">文本动画</span>
                            <span class="settingDesc">
                                如果文本显示效果影响到了性能，可以关闭它
                            </span>
                        </div>
                        <div class="options" role="group" aria-label="文本动画">
                            <button
                                type="button"
                                class="option"
                                data-gate-motion="on"
                            >
                                开启
                            </button>
                            <button
                                type="button"
                                class="option"
                                data-gate-motion="off"
                            >
                                关闭
                            </button>
                        </div>
                    </div>
                    <div class="setting">
                        <div class="settingText">
                            <span class="settingName">暗黑模式</span>
                            <span class="settingDesc">默认跟随系统</span>
                        </div>
                        <div class="options" role="group" aria-label="暗黑模式">
                            <button
                                type="button"
                                class="option"
                                data-gate-theme="system"
                            >
                                跟随系统
                            </button>
                            <button
                                type="button"
                                class="option"
                                data-gate-theme="light"
                            >
                                亮色
                            </button>
                            <button
                                type="button"
                                class="option"
                                data-gate-theme="dark"
                            >
                                暗色
                            </button>
                        </div>
                    </div>
                    <div class="setting">
                        <div class="settingText">
                            <span class="settingName">自定义指针</span>
                            <span class="settingDesc">
                                像素指针样式与点击涟漪动效
                            </span>
                        </div>
                        <div
                            class="options"
                            role="group"
                            aria-label="自定义指针"
                        >
                            <button
                                type="button"
                                class="option"
                                data-gate-cursor="on"
                            >
                                开启
                            </button>
                            <button
                                type="button"
                                class="option"
                                data-gate-cursor="off"
                            >
                                关闭
                            </button>
                        </div>
                    </div>
                    <div class="actions">
                        <button
                            type="button"
                            class="btn btnPrimary"
                            data-gate-settings-ok
                        >
                            确认设置
                        </button>
                    </div>
                    <!-- 确认回执：替代按钮组显示（文本由脚本写入） -->
                    <p class="doneNote" data-gate-done-note></p>
                </div>
            </section>
        </div>
    </div>
</div>

<style>
    .gate {
        box-sizing: border-box;
        position: fixed;
        inset: 0;
        z-index: 400;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 2em;
        overflow-y: auto;
        background-color: var(--bg);
        background-image: repeating-linear-gradient(
            0deg,
            transparent,
            transparent 3px,
            rgba(var(--gray), 0.05) 3px,
            rgba(var(--gray), 0.05) 4px
        );
    }

    :global(html.gate-open) .gate,
    .gate.closing {
        display: flex;
    }

    .wrap {
        box-sizing: border-box;
        width: min(var(--content-width), 100%);
        margin: auto;
        display: flex;
        flex-direction: column;
        gap: 1.8em;
    }

    .gateCmd {
        white-space: nowrap;
        font-size: 1.05em;
    }

    .cards {
        display: flex;
        gap: 2.2em;
        align-items: stretch;
    }

    .card {
        display: flex;
        flex-direction: column;
        position: relative;
        flex: 1 1 0;
        min-width: 0;
        box-sizing: border-box;
        padding: 2.4em 1.7em 1.5em;
        border: 1px solid var(--line);
        background: var(--bg);
    }

    .cardCookie {
        border-color: var(--green);
    }

    .cardSettings {
        border-color: var(--blue);
    }

    .cardTitle {
        position: absolute;
        top: -0.7em;
        left: 50%;
        transform: translateX(-50%);
        padding: 0 0.8em;
        background: var(--bg);
        font-size: 1.05em;
        line-height: 1.3;
        white-space: nowrap;
        margin: 0;
    }

    .cardCookie .cardTitle {
        color: var(--green);
    }

    .cardSettings .cardTitle {
        color: var(--blue);
    }

    .body {
        flex: 1;
        display: flex;
        flex-direction: column;
    }

    .lead {
        margin: 0 0 1.1em;
    }

    .uses {
        list-style: none;
        margin: 0 0 1.5em;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 1em;
    }

    .use {
        display: flex;
        align-items: flex-start;
        gap: 0.8em;
    }

    .use p {
        margin: 0;
        font-size: 0.92em;
        line-height: 1.6;
    }

    .tag {
        flex: none;
        margin-top: 0.15em;
        padding: 0.05em 0.55em;
        font-size: 0.78em;
        border: 1px solid;
        white-space: nowrap;
    }

    .tagNecessary {
        color: var(--green);
        border-color: var(--green);
    }

    .tagStats {
        color: var(--yellow);
        border-color: var(--yellow);
    }

    /* 操作按钮：像素风实心 / 描边互换 */
    .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9em;
        /* 钉在卡片底部，两卡底线对齐 */
        margin-top: auto;
    }

    .cardSettings .actions {
        margin-top: 0;
        justify-content: center;
    }

    .doneNote {
        display: none;
        align-items: center;
        gap: 0.5em;
        margin: auto 0 0 0;
        color: var(--green);
        font-size: 0.9em;
    }

    .cardSettings .doneNote {
        margin: 0;
        justify-content: center;
        color: var(--blue);
    }

    .card.done .doneNote {
        display: flex;
    }

    .card.done .actions {
        display: none;
    }

    .btn {
        font: inherit;
        font-size: 0.95em;
        padding: 0.5em 1.5em;
        color: var(--green);
        background: transparent;
        border: 1px solid var(--green);
    }

    .btn:hover {
        background: var(--green);
        color: var(--bg);
    }

    .btnPrimary {
        background: var(--green);
        color: var(--bg);
    }

    .btnPrimary:hover {
        background: transparent;
        color: var(--green);
    }

    .cardSettings .btn {
        color: var(--blue);
        border-color: var(--blue);
    }

    .cardSettings .btn:hover {
        background: var(--blue);
        color: var(--bg);
    }

    .cardSettings .btnPrimary {
        background: var(--blue);
        color: var(--bg);
    }

    .cardSettings .btnPrimary:hover {
        background: transparent;
        color: var(--blue);
    }

    .btn:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .note {
        margin: 1em 0 0;
        color: rgb(var(--gray));
        font-size: 0.78em;
    }

    .cardSettings .body {
        justify-content: center;
        gap: 1.6em;
    }

    .setting {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 0.5em 1em;
    }

    .settingText {
        display: flex;
        flex-direction: column;
        gap: 0.15em;
        min-width: 0;
    }

    .settingName {
        color: rgb(var(--black));
    }

    .settingDesc {
        color: rgb(var(--gray));
        font-size: 0.78em;
    }

    .options {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5em;
    }

    .option {
        font: inherit;
        font-size: 0.85em;
        padding: 0.25em 0.9em;
        color: var(--blue);
        background: transparent;
        border: 1px solid var(--blue);
    }

    .option:hover:not(.active) {
        background: color-mix(in srgb, var(--blue) 15%, transparent);
    }

    .option.active {
        background: var(--blue);
        color: var(--bg);
    }

    .option:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    :global(html.gate-open) [data-gate-scramble] {
        visibility: hidden;
    }

    :global(html.gate-open) [data-gate-scramble].in {
        visibility: visible;
    }

    @media (prefers-reduced-motion: no-preference) {
        .gateCmd {
            animation: gate-cmd-in 0.25s ease backwards;
        }

        .card {
            animation: gate-card-in 0.28s ease backwards;
        }

        .cardSettings {
            animation-delay: 0.1s;
        }

        .gate.closing {
            animation: gate-out 0.3s ease forwards;
        }
    }

    @keyframes gate-cmd-in {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes gate-card-in {
        from {
            opacity: 0;
            transform: translateY(10px);
        }
        to {
            opacity: 1;
            transform: none;
        }
    }

    @keyframes gate-out {
        to {
            opacity: 0;
        }
    }

    @media (max-width: 720px) {
        .gate {
            padding: 1.2em;
        }

        .cards {
            flex-direction: column;
            gap: 2em;
        }
    }
</style>
